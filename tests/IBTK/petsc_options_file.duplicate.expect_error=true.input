Main {
    petsc_settings {
        ksp_type = "fgmres"
    }
    petsc_settings_SP {
        pc_type = "none"
    }
    petsc_settings_poisson {
        ksp_type = "cg"
        rtol = 1.0e-12
        atol = "0.0"
    }
}

PoissonKrylovSolver {
    petsc_options_prefix = "poisson"
    petsc_settings {
        poisson_ksp_type = "cg"
        poisson_max_it = 30
    }
}

PoissonMultigridPreconditioner {
    petsc_options_prefix = "poisson_mg"
    petsc_settings_poisson_mg {
        ksp_type = "preonly"
        max_it = 1
    }
}
